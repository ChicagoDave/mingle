{
  "name": "mingle-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --exclude '**/*.real.test.ts'",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:realpath": "vitest run test/install.real.test.ts test/image.real.test.ts test/healthz.real.test.ts test/notifications.real.test.ts test/api-v1.real.test.ts test/ldap-starttls.real.test.ts",
    "test:ldap-tls": "vitest run test/ldap-starttls.real.test.ts",
    "test:image": "vitest run test/image.real.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:mutation": "stryker run",
    "test:install": "vitest run test/install.real.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@node-saml/node-saml": "^5.1.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.10",
    "ldapts": "^9.0.0",
    "nodemailer": "^9.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/oidc-provider": "^9.11.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "ldapjs": "^3.0.7",
    "oidc-provider": "^9.12.0",
    "samlify": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
